   "print 'Phase 1 (Fast equilibration): using ninsert/delete = ${gcmc_ninsert_fast}'"

if "${current_phase} == 2" then &
   "print 'Phase 2 (Fine tuning): using ninsert/delete = ${gcmc_ninsert_fine}'"
   
if "${current_phase} == 2 && ${N_stat} == $(v_Nphase1+1)" then &
   "print '====== Switching to Phase 2 (Fine tuning) ======'" &
   "print 'Changing ninsert/delete from ${gcmc_ninsert_fast} to ${gcmc_ninsert_fine}'" &
   "unfix mygcmc" &
   "fix mygcmc O_ads_atoms_dyn gcmc ${gcmc_freq} ${gcmc_ninsert_fine} ${gcmc_ndelete_fine} 3 ${seed} ${T} 0.0 ${gcmc_displace} pressure ${P} region gcmc_region tfac_insert 1.0 full_energy"

if "${current_phase} == 3" then &
   "print 'Phase 3 (Equilibrium sampling): using ninsert/delete = ${gcmc_ninsert_equil}'"
   
if "${current_phase} == 3 && ${N_stat} == $(v_Nphase2+1)" then &
   "print '====== Switching to Phase 3 (Equilibrium sampling) ======'" &
