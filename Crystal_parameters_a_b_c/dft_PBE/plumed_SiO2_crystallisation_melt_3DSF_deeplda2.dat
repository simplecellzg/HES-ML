# vim:ft=plumed
#RESTART
UNITS LENGTH=A

# Define CVs
ENVIRONMENTSIMILARITY ...
 SPECIES=1-324
 SIGMA=0.4
 LATTICE_CONSTANTS=5.431
 CRYSTAL_STRUCTURE=DIAMOND
 LABEL=refcv
 MORE_THAN={RATIONAL R_0=0.5 NN=12 MM=24}
 MEAN
... ENVIRONMENTSIMILARITY

ene: ENERGY
vol: VOLUME
epv: COMBINE PERIODIC=NO COEFFICIENTS=1,0.06022140857 ARG=ene,vol

Q6 SPECIES=1-324 SWITCH={CUBIC D_0=2.35 D_MAX=3} VMEAN LOWMEM LABEL=q6

# Define descriptors
#cv: STRUCTURE_FACTOR_DESCRIPTOR_TEST ACTIVE_SHELLS=27,72,99,144,171,216,243,288,315 STRUCTURE=DIAMOND UNIT_CELLS=3

cv: STRUCTURE_FACTOR_DESCRIPTOR_TEST NO_VIRIAL N2_MAX=30


sf3d_1: COMBINE ARG=cv.Sk-[3_-2_0],cv.Sk-[3_2_0],cv.Sk-[0_4_0] COEFFICIENTS=0.35,0.35,0.35 PERIODIC=NO
sf3d_2: COMBINE ARG=cv.Sk-[3_-2_-3],cv.Sk-[3_-2_3],cv.Sk-[3_2_-3],cv.Sk-[3_2_3],cv.Sk-[0_4_-3],cv.Sk-[0_4_3] COEFFICIENTS=0.8,0.65,0.7,0.75,0.8,0.65 PERIODIC=NO

# Define Bias

OPES_METAD_EXPLORE ... 
LABEL=opes1
#ARG=deeplda.node-0
ARG=sf3d_1,sf3d_2
PACE=100
#SIGMA=0.02,0.02
#SIGMA_MIN=0.001
ADAPTIVE_SIGMA_STRIDE=100
BARRIER=2000
TEMP=2000
FILE=KERNELS_LDA
... OPES_METAD_EXPLORE


# constraint
