# vim:ft=plumed
#RESTART
UNITS LENGTH=A

surf_si_o_rec: GROUP ATOMS=67-70,73-78,81-84,87-92,95-98,101-106,109-112,115-120,187-190,193-198,201-204,207-212,215-218,221-226,229-232,235-240
gas_O: GROUP ATOMS=257

ene: ENERGY
#t1: TIME
ghosta: FIXEDATOM AT=10,8,11
zdis_O_up1: DISTANCE ATOMS=257,ghosta 
#zdis_O_up2: DISTANCE ATOMS=ghosta,257 COMPONENTS
uwall: UPPER_WALLS ARG=zdis_O_up1 AT=8 KAPPA=1000 EXP=2
#func1: CUSTOM ARG=t1,zdis_O_up2.z FUNC=step(1.0-x)*step(1.0-y)*1000 PERIODIC=NO
#uwall2: UPPER_WALLS ARG=zdis_O_up2.z AT=6 KAPPA=1000 EXP=2
#lwall: BIASVALUE ARG=func1

C1: COORDINATION GROUPA=surf_si_o_rec GROUPB=gas_O SWITCH={RATIONAL R_0=1.6 D_MAX=8}


OPES_METAD ... 
LABEL=opes2
ARG=C1
PACE=60
#SIGMA=0.3
#BIASFACTOR=100
ADAPTIVE_SIGMA_STRIDE=1000
BARRIER=500
TEMP=1100
... OPES_METAD



PRINT ARG=* FILE=colvar STRIDE=1
FLUSH STRIDE=1


